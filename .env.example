# clinics_sync_service · variables de configuración y secretos
#
# Copiar a `.env` en la raíz del repo y completar. `.env` está en .gitignore: NUNCA se versiona.
#
#   cp .env.example .env && chmod 600 .env
#
# Alternativa: usar ~/.config/clinics/secrets/sync.yml (por defecto) en vez de `.env`.
# Ver "Dónde poner los secretos" más abajo.

# ---------------------------------------------------------------------------
# Base de datos local (PostgreSQL 16). Requerida: la app no arranca sin ella.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=clinics_sync
DB_USER=sync_app
DB_PASSWORD=

# Puerto host donde se publica Postgres. 5432 ya lo ocupa peer-guard-compII.
DB_PORT=55432

# Contraseña del ADMINISTRADOR de Postgres. La usa solo el compose para
# inicializar el volumen; la aplicación nunca la usa.
POSTGRES_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Redis. Requerida para el lector del catálogo de la cátedra.
# La contraseña llega en la respuesta de /api/student/register, no antes.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Cuenta técnica de la cátedra.
#
# OJO: la cuenta se registra UNA SOLA VEZ (enunciado §9). Antes de eso, el servicio
# tiene que poder arrancar igual: dejar provisioning_status=PENDING.
# El groupId es INMUTABLE: queda congelado en topics de Kafka y namespaces de Redis.
# ---------------------------------------------------------------------------
CATEDRA_BASE_URL=http://172.17.201.1:8090
CATEDRA_GROUP_ID=nicobartok0-prog2
CATEDRA_TECHNICAL_USER=
CATEDRA_TECHNICAL_PASSWORD=
CATEDRA_REDIS_HOST=172.17.201.1
CATEDRA_REDIS_PORT=6379
CATEDRA_PROVISIONING_STATUS=PENDING

# ---------------------------------------------------------------------------
# Kafka de la cátedra.
# ---------------------------------------------------------------------------
CATEDRA_BOOTSTRAP_SERVERS=172.17.201.1:9094
CATEDRA_KAFKA_TOPIC_CATALOG=catedra.catalog.${CATEDRA_GROUP_ID}

# ---------------------------------------------------------------------------
# Desarrollo local.
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev