# clinics_sync_service · variables de configuración y secretos
#
# Copiar a `.env` en la raíz del repo y completar. `.env` está en .gitignore: NUNCA se versiona.
#
#   cp .env.example .env && chmod 600 .env
#
# Alternativa: usar ~/.config/clinics/secrets/sync.yml (por defecto) en vez de `.env`.
# Ver "Dónde poner los secretos" más abajo.

# ---------------------------------------------------------------------------
# Base de datos local (PostgreSQL 16). Requerida: la app no arranca sin ella.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=clinics_sync
DB_USER=sync_app
DB_PASSWORD=

# Puerto host donde se publica Postgres. 5432 ya lo ocupa peer-guard-compII.
DB_PORT=55432

# Contraseña del ADMINISTRADOR de Postgres. La usa solo el compose para
# inicializar el volumen; la aplicación nunca la usa.
POSTGRES_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Redis. Requerida para el lector del catálogo de la cátedra.
# La contraseña llega en la respuesta de /api/student/register, no antes.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Cuenta técnica de la cátedra.
#
# OJO: la cuenta se registra UNA SOLA VEZ (enunciado §9). Antes de eso, el servicio
# tiene que poder arrancar igual: dejar provisioning_status=PENDING.
# El groupId es INMUTABLE: queda congelado en topics de Kafka y namespaces de Redis.
# ---------------------------------------------------------------------------
CATEDRA_BASE_URL=http://172.17.201.1:8090
CATEDRA_GROUP_ID=nicobartok0-prog2
CATEDRA_TECHNICAL_USER=
CATEDRA_TECHNICAL_PASSWORD=
# JWT que devolvio POST /api/student/register. Opcional: si falta o vencio, el
# servicio pide uno nuevo con POST /api/authenticate. NUNCA se versiona ni se loguea.
CATEDRA_TECHNICAL_JWT=
CATEDRA_REDIS_HOST=172.17.201.1
CATEDRA_REDIS_PORT=6379
# PENDING hasta registrar la cuenta tecnica (POST /api/student/register, una sola vez).
# Despues de registrar, ponelo en PROVISIONED: si queda en PENDING el servicio no
# intenta ni autenticarse.
CATEDRA_PROVISIONING_STATUS=PENDING

# ---------------------------------------------------------------------------
# Kafka de la cátedra.
# ---------------------------------------------------------------------------
# El broker de Kafka. Lo da la catedra en el documento de integracion.
KAFKA_BOOTSTRAP_SERVERS=172.17.201.1:9094
# El topic donde la catedra publica los avisos de version nueva del catalogo.
CATEDRA_CATALOG_TOPIC=catedra.catalog.nicobartok0-prog2
CATEDRA_CONSUMER_GROUP=clinics-sync
CATEDRA_KAFKA_ENABLED=true
CATEDRA_KAFKA_RETRIES=3
CATEDRA_KAFKA_RETRY_INTERVAL_MS=1000
# Cada cuanto se compara la version local con la que hay disponible.
CLINICS_SYNC_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# JWT (resource server).
#
# Solo la PÚBLICA: este servicio valida tokens, no los emite. La privada nunca
# debe estar en esta máquina. Generar el par:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out privada.pem
#   openssl rsa -pubout -in privada.pem -out publica.pem
# ---------------------------------------------------------------------------
CLINICS_JWT_PUBLIC_KEY_PATH=
CLINICS_JWT_AUDIENCE=clinics
CLINICS_JWT_ISSUER=
# Orígenes permitidos por CORS, separados por coma. Nunca "*".
CLINICS_CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Desarrollo local.
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev